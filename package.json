{
  "name": "adalat-diary",
  "version": "0.8.1",
  "private": true,
  "description": "Adalat Diary - a court diary for advocates. Case records, cause lists and next dates, offline-first.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "migrate:crn": "node --env-file=.env.local scripts/migrate-crn-index.mjs",
    "csv:prompt": "node --experimental-strip-types scripts/generate-csv-prompt.mjs"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "mongoose": "^8.9.5",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "^0.0.1",
    "swr": "^2.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "browserslist": {
    "production": [
      "Chrome >= 58",
      "Android >= 4.4.3",
      "iOS >= 12",
      "Safari >= 12"
    ],
    "development": [
      "last 1 Chrome version",
      "last 1 Firefox version",
      "last 1 Safari version"
    ]
  }
}
