# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas or self-hosted connection string.
# If the password contains @ : / ? # [ ] or %, percent-encode it.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="adalat_diary"

# ─── App ─────────────────────────────────────────────────────────────────────
# Log verbosity: debug | info | warn | error.
# Defaults to debug in development, info in production.
LOG_LEVEL="info"

NEXT_PUBLIC_APP_NAME="Adalat Diary"
# On Vercel, set this to your real deployment URL after the first deploy.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
